# Copy to .env.local and fill in from your Supabase project settings (API section).
# NEXT_PUBLIC_* values are safe to expose to the browser.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key (safe for the browser; RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Bypasses RLS — NEVER expose to the browser, never prefix NEXT_PUBLIC_.
# Used only in trusted server code (e.g. admin tasks, seeding). Optional for local dev.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables AI "Suggest from photo" for fabrics (photo → attributes).
# Server-only — never prefix NEXT_PUBLIC_. Leave blank to keep manual entry;
# the feature simply stays hidden without a key.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to a fast, low-cost model for this task.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Stripe keys are NOT needed for Phase 1 (no payments). Added in Phase 2.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
